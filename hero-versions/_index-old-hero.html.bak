<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Self-Healing Communities Fund — Hero Concepts</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg" />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    /* SHCF brand palette — emerald-led, warm cream canvas */
    --emerald:#009169;        /* deep emerald — primary brand */
    --emerald-bright:#00DBB6; /* bright emerald — accent */
    --emerald-deep:#06513C;   /* near-black emerald — ink-equivalent */
    --emerald-soft:#A4D6C6;   /* tint */
    --paper:#F4ECDC;          /* warm cream canvas (human, warm) */
    --paper-warm:#EFE2CB;
    --cream:#FBF6EA;          /* lightest paper */
    --terracotta:#C9442F;     /* used only for "fragmented" side of contrast */
    --terracotta-soft:#E8A88E;
    --ink:#0F2A22;            /* dark green-ink for body text */
    --ink-soft:#4A5F58;
    --rule: rgba(15,42,34,.16);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased}
  body{min-height:100vh}

  /* ---------- Top selector ---------- */
  .selector{
    position:sticky;top:0;z-index:100;
    background:rgba(244,236,220,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--rule);
  }
  .selector-inner{
    max-width:1400px;margin:0 auto;
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 32px;
  }
  .brand{display:flex;align-items:center;gap:14px}
  .brand img{height:32px;display:block}
  .brand small{font-family:'Inter';font-weight:400;color:var(--ink-soft);font-size:11px;letter-spacing:.16em;text-transform:uppercase;padding-left:14px;border-left:1px solid var(--rule)}
  .tabs{display:flex;gap:4px;background:var(--cream);padding:4px;border-radius:999px;border:1px solid var(--rule)}
  .tab{
    border:0;background:transparent;cursor:pointer;
    font-family:'Inter';font-size:13px;font-weight:500;color:var(--ink-soft);
    padding:8px 16px;border-radius:999px;letter-spacing:.01em;
    transition:all .25s ease;
  }
  .tab:hover{color:var(--ink)}
  .tab.active{background:var(--emerald);color:var(--cream)}
  .tab .num{font-family:'Fraunces',serif;font-style:italic;font-weight:400;opacity:.7;margin-right:6px}

  /* ---------- Hero container ---------- */
  .stage{display:none}
  .stage.active{display:block}

  /* shared bits */
  .eyebrow{
    font-family:'Inter';text-transform:uppercase;letter-spacing:.22em;
    font-size:11px;color:var(--ink-soft);font-weight:500;
  }
  .h1{
    font-family:'Fraunces',serif;font-weight:400;
    font-size:clamp(44px,7vw,104px);line-height:1.02;letter-spacing:-.02em;
  }
  .h1 em{font-style:italic;color:var(--emerald);font-weight:300}
  .lede{font-size:18px;line-height:1.55;color:var(--ink-soft);max-width:46ch}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    background:var(--emerald);color:var(--cream);text-decoration:none;
    padding:14px 22px;border-radius:999px;font-weight:500;font-size:14px;
    transition:transform .2s ease, background .2s ease;
  }
  .btn:hover{transform:translateY(-1px);background:var(--emerald-deep)}
  .btn .arrow{display:inline-block;transition:transform .2s ease}
  .btn:hover .arrow{transform:translateX(3px)}
  .btn.alt{background:transparent;color:var(--emerald);border:1px solid var(--emerald)}
  .btn.alt:hover{background:var(--emerald);color:var(--cream)}
  .meta{display:flex;gap:24px;color:var(--ink-soft);font-size:12px;letter-spacing:.05em;text-transform:uppercase}
  .meta span{display:flex;align-items:center;gap:8px}
  .meta span::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--emerald)}

  /* description banner at top of each */
  .desc{
    max-width:1400px;margin:0 auto;padding:18px 32px 0;
    display:flex;gap:24px;align-items:baseline;color:var(--ink-soft);font-size:13px;
  }
  .desc b{font-family:'Fraunces',serif;font-style:italic;color:var(--ink);font-weight:500;font-size:14px}

  /* ============================================================
     VERSION 1 — The Unfolding Book (accordion pages, horizontal)
     ============================================================ */
  #v1 .scroll-area{height:500vh;position:relative}
  #v1 .sticky{
    position:sticky;top:0;height:100vh;overflow:hidden;
    background:linear-gradient(180deg,#F4ECDC 0%,#EFE2CB 100%);
  }
  #v1 .grain{
    position:absolute;inset:0;pointer-events:none;opacity:.5;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='0.9' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 0.16  0 0 0 0 0.12  0 0 0 0 0.08  0 0 0 0.18 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  #v1 .accordion{
    position:absolute;top:50%;right:4vw;transform:translateY(-50%);
    display:flex;gap:0;perspective:1800px;
  }
  #v1 .page{
    width:17vw;min-width:200px;height:58vh;min-height:380px;
    background:var(--cream);
    border:1px solid rgba(42,30,21,.1);
    box-shadow:0 30px 60px -30px rgba(42,30,21,.35);
    transform-origin:left center;
    padding:32px 26px;
    display:flex;flex-direction:column;justify-content:space-between;
    position:relative;
    transition:transform .05s linear;
  }
  #v1 .page:nth-child(even){transform-origin:right center}
  #v1 .page .pnum{font-family:'Fraunces',serif;font-style:italic;color:var(--emerald);font-size:14px}
  #v1 .page h3{font-family:'Fraunces',serif;font-weight:400;font-size:28px;line-height:1.1;letter-spacing:-.01em;margin-top:auto}
  #v1 .page p{font-size:12.5px;line-height:1.5;color:var(--ink-soft);margin-top:10px}
  #v1 .page .img{
    width:100%;aspect-ratio:1/1.1;background-size:cover;background-position:center;
    border-radius:2px;filter:sepia(.08) saturate(.95);
  }
  /* colors per page — narrative: earth (fragmented) → growth (self-healing) */
  #v1 .page.p1{background:#EFE2CB}
  #v1 .page.p2{background:#E8A88E}
  #v1 .page.p3{background:#A4D6C6}
  #v1 .page.p3 .pnum{color:var(--emerald-deep)}
  #v1 .page.p4{background:var(--emerald);color:var(--cream)}
  #v1 .page.p4 p{color:rgba(251,246,234,.85)}
  #v1 .page.p4 .pnum{color:var(--emerald-bright)}
  #v1 .page.p5{background:var(--emerald-deep);color:var(--cream)}
  #v1 .page.p5 p{color:rgba(251,246,234,.85)}
  #v1 .page.p5 .pnum{color:var(--emerald-bright)}

  #v1 .copy-panel{
    position:absolute;left:0;top:0;bottom:0;width:38vw;min-width:380px;max-width:560px;
    background:var(--cream);
    border-right:1px solid var(--rule);
    box-shadow:30px 0 60px -30px rgba(42,30,21,.18);
    padding:14vh 5vw 14vh 5vw;
    display:flex;flex-direction:column;justify-content:space-between;
    z-index:6;
  }
  #v1 .copy-panel .h1{font-size:clamp(40px,4.2vw,68px);color:var(--ink)}
  #v1 .copy-panel .lede{margin-top:22px;font-size:15.5px;color:var(--ink-soft)}
  #v1 .copy-panel .foot{display:flex;align-items:center;gap:16px;color:var(--ink-soft);font-size:11px;letter-spacing:.18em;text-transform:uppercase}
  #v1 .copy-panel .foot .line{flex:1;height:1px;background:var(--rule)}
  #v1 .progress{
    position:absolute;bottom:32px;right:4vw;
    display:flex;align-items:center;gap:14px;color:var(--ink-soft);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  }
  #v1 .bar{width:200px;height:2px;background:rgba(42,30,21,.15);border-radius:2px;overflow:hidden}
  #v1 .bar i{display:block;height:100%;background:var(--emerald);width:0%}

  /* ============================================================
     VERSION 2 — Floating Shapes (shapeshift from friction to flow)
     ============================================================ */
  #v2 .scroll-area{height:400vh;position:relative}
  #v2 .sticky{
    position:sticky;top:0;height:100vh;overflow:hidden;
    background:radial-gradient(ellipse at 50% 60%, #F8F0DE 0%, #F4ECDC 50%, #ECE0C5 100%);
    transition:background 1s ease;
  }
  #v2 .blobs{position:absolute;inset:0;width:100%;height:100%}
  #v2 .blobs svg{position:absolute;inset:0;width:100%;height:100%}
  #v2 .grain{
    position:absolute;inset:0;pointer-events:none;opacity:.35;mix-blend-mode:multiply;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='0.9' numOctaves='2' seed='7'/><feColorMatrix values='0 0 0 0 0.06  0 0 0 0 0.16  0 0 0 0 0.13  0 0 0 0.14 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  #v2 .copy-c{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    padding:0 6vw;z-index:10;pointer-events:none;
  }
  #v2 .copy-c .inner{
    max-width:820px;text-align:center;padding:48px 56px;
    background:radial-gradient(ellipse at center, rgba(251,246,234,.85) 0%, rgba(251,246,234,.55) 60%, rgba(251,246,234,0) 100%);
    border-radius:24px;
  }
  #v2 .copy-c .eyebrow{color:var(--ink-soft)}
  #v2 .copy-c .h1{
    font-size:clamp(48px,7.4vw,120px);color:var(--ink);
    margin-top:20px;line-height:.98;
  }
  #v2 .copy-c .h1 em{color:var(--emerald)}
  #v2 .copy-c .lede{color:var(--ink-soft);margin:24px auto 30px;max-width:52ch}
  #v2 .copy-c .btn{pointer-events:auto}

  #v2 .labels{
    position:absolute;bottom:42px;left:0;right:0;display:flex;justify-content:space-between;
    padding:0 6vw;z-index:11;color:var(--ink-soft);
    font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  }
  #v2 .labels .now{color:var(--emerald);transition:opacity .4s}
  #v2 .labels .arrow{flex:1;display:flex;align-items:center;justify-content:center;gap:14px}
  #v2 .labels .arrow .line{flex:1;max-width:240px;height:1px;background:var(--rule);position:relative;overflow:hidden}
  #v2 .labels .arrow .line i{position:absolute;left:0;top:0;height:100%;width:0%;background:var(--emerald);transition:width .1s linear}

  /* ============================================================
     VERSION 3 — Particle Wayfinding (chaos dots → flowing path)
     ============================================================ */
  #v3 .scroll-area{height:450vh;position:relative}
  #v3 .sticky{
    position:sticky;top:0;height:100vh;overflow:hidden;
    background:radial-gradient(ellipse at 30% 20%,#F8EFDC 0%,#EFE2CB 60%,#E6D4B5 100%);
  }
  #v3 canvas{position:absolute;inset:0;width:100%;height:100%}
  #v3 .photos{
    position:absolute;inset:0;pointer-events:none;
  }
  #v3 .ph{
    position:absolute;width:clamp(280px,24vw,440px);aspect-ratio:4/5;
    background-size:cover;background-position:center;
    border-radius:4px;opacity:0;transform:scale(.94);
    box-shadow:0 50px 90px -35px rgba(15,42,34,.45), 0 12px 30px -10px rgba(15,42,34,.18);
    transition:opacity 1s ease,transform 1s cubic-bezier(.2,.7,.2,1);
    border:10px solid var(--cream);
    will-change:transform;
  }
  #v3 .ph.show{opacity:1;transform:scale(1)}
  #v3 .ph.p1{top:8%;left:3%;transform:rotate(-4deg) scale(.94)}
  #v3 .ph.p1.show{transform:rotate(-4deg) scale(1)}
  #v3 .ph.p2{bottom:6%;left:6%;transform:rotate(3deg) scale(.94);width:clamp(240px,20vw,380px)}
  #v3 .ph.p2.show{transform:rotate(3deg) scale(1)}
  #v3 .ph.p3{top:6%;right:4%;transform:rotate(5deg) scale(.94);width:clamp(260px,22vw,400px)}
  #v3 .ph.p3.show{transform:rotate(5deg) scale(1)}
  #v3 .ph.p4{bottom:8%;right:6%;transform:rotate(-3deg) scale(.94);width:clamp(240px,21vw,400px)}
  #v3 .ph.p4.show{transform:rotate(-3deg) scale(1)}

  #v3 .copy{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    text-align:center;max-width:760px;width:90%;z-index:5;pointer-events:none;
    padding:56px 48px;
    background:radial-gradient(ellipse at center, rgba(248,239,220,.92) 0%, rgba(248,239,220,.7) 55%, rgba(248,239,220,0) 100%);
    border-radius:24px;
  }
  #v3 .copy .eyebrow{margin-bottom:18px}
  #v3 .copy .h1{font-size:clamp(40px,6.5vw,92px)}
  #v3 .copy .lede{margin:22px auto 28px}
  #v3 .copy .btn{pointer-events:auto}
  #v3 .corners{
    position:absolute;inset:24px;display:flex;justify-content:space-between;align-items:flex-start;
    pointer-events:none;color:var(--ink-soft);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
    z-index:6;
  }
  #v3 .corners .r{text-align:right}

  /* ============================================================
     VERSION 4 — Life Course (book pages, vertical chapters)
     ============================================================ */
  #v4 .scroll-area{height:450vh;position:relative}
  #v4 .sticky{position:sticky;top:0;height:100vh;overflow:hidden;background:var(--cream)}
  #v4 .layout{
    position:absolute;inset:0;
    display:flex;align-items:stretch;
  }
  #v4 .left{flex:1.1 1 0;min-width:0;min-height:0;overflow:hidden}
  #v4 .right{flex:1 1 0;min-width:0;min-height:0}
  #v4 .left{
    position:relative;padding:6vh 5vw;display:flex;flex-direction:column;justify-content:space-between;gap:24px;
    background:var(--paper);
  }
  #v4 .left .h1{font-size:clamp(36px,3.6vw,60px)}
  #v4 .left::after{
    content:"";position:absolute;top:8vh;bottom:8vh;right:0;width:1px;background:var(--rule);
  }
  #v4 .chapter-label{display:flex;align-items:baseline;gap:14px}
  #v4 .chapter-label .num{font-family:'Fraunces',serif;font-style:italic;font-size:80px;line-height:1;color:var(--emerald);font-weight:300}
  #v4 .chapter-label .of{color:var(--ink-soft);font-size:12px;letter-spacing:.2em;text-transform:uppercase}

  #v4 .stages{flex:1;display:flex;flex-direction:column;justify-content:center;padding:40px 0}
  #v4 .stage-item{
    position:relative;padding:14px 0 14px 28px;border-left:2px solid transparent;
    transition:all .4s ease;opacity:.35;
  }
  #v4 .stage-item.active{opacity:1;border-color:var(--emerald)}
  #v4 .stage-item h2{font-family:'Fraunces',serif;font-weight:400;font-size:32px;line-height:1.15;letter-spacing:-.01em}
  #v4 .stage-item p{margin-top:8px;font-size:14px;color:var(--ink-soft);max-width:42ch;line-height:1.55}

  #v4 .right{
    position:relative;overflow:hidden;background:var(--emerald-deep);
    display:flex;align-items:center;justify-content:center;
    padding:4vh 3vw 5vh;
  }
  #v4 .right::before{
    content:"";position:absolute;inset:0;
    background:
      radial-gradient(ellipse at 50% 110%, rgba(0,0,0,.45), transparent 60%),
      radial-gradient(ellipse at 50% 50%, rgba(0,219,182,.06), transparent 70%);
    pointer-events:none;
  }
  /* Book container — vh-driven size guarantees it fits the fold */
  #v4 .book{
    position:relative;
    width:min(100%, 70vh, 680px);
    aspect-ratio:4/3;
    perspective:2600px;
    transform-style:preserve-3d;
    flex-shrink:0;
  }
  /* Soft shadow puddle under the book */
  #v4 .book::after{
    content:"";position:absolute;left:6%;right:6%;bottom:-22px;height:24px;
    background:radial-gradient(ellipse at center, rgba(0,0,0,.55), transparent 70%);
    filter:blur(10px);z-index:0;
  }
  /* Page-edge stacks on outer sides to suggest thickness */
  #v4 .book .edge{
    position:absolute;top:1.5%;bottom:1.5%;width:7px;
    background:repeating-linear-gradient(180deg,#EFE2CB 0 1.5px,#D8C8A6 1.5px 3px);
    z-index:1;border-radius:1px;
    box-shadow:0 4px 8px -3px rgba(0,0,0,.4);
  }
  #v4 .book .edge.left{left:-7px;border-radius:2px 0 0 2px}
  #v4 .book .edge.right{right:-7px;border-radius:0 2px 2px 0}

  /* Static base spread — the cream paper that lives under all leaves */
  #v4 .book-base{
    position:absolute;inset:0;display:flex;z-index:2;
    box-shadow:0 30px 60px -20px rgba(0,0,0,.55);
    border-radius:2px;
    overflow:hidden;
  }
  #v4 .book-base .page{
    flex:1;position:relative;
    background:linear-gradient(180deg,#F8EFDC 0%,#EFE2CB 100%);
  }
  #v4 .book-base .page.page-left{box-shadow:inset -28px 0 36px -16px rgba(0,0,0,.22)}
  #v4 .book-base .page.page-right{box-shadow:inset 28px 0 36px -16px rgba(0,0,0,.22)}
  #v4 .book-base .page .end-mark{
    position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);
    text-align:center;font-family:'Fraunces',serif;font-style:italic;color:var(--ink-soft);
    font-size:14px;letter-spacing:.05em;
  }

  /* Central spine */
  #v4 .spine{
    position:absolute;left:50%;top:0;bottom:0;width:8px;margin-left:-4px;
    background:linear-gradient(90deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.55) 50%, rgba(0,0,0,.35) 100%);
    z-index:60;pointer-events:none;
    box-shadow:0 0 8px rgba(0,0,0,.4);
  }

  /* Leaves container preserves 3d so leaves can sit in 3D space */
  #v4 .leaves{position:absolute;inset:0;transform-style:preserve-3d;z-index:5}

  /* Each leaf occupies the right half and pivots on the spine */
  #v4 .leaf{
    position:absolute;top:0;left:50%;width:50%;height:100%;
    transform-origin:left center;
    transform-style:preserve-3d;
    will-change:transform;
  }
  #v4 .leaf .face{
    position:absolute;inset:0;
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
    background-size:cover;background-position:center;
    border-radius:0 2px 2px 0;
    overflow:hidden;
  }
  /* Recto = the photo (right page when leaf flat at 0deg) */
  #v4 .leaf .recto{
    box-shadow:inset 28px 0 36px -16px rgba(0,0,0,.18);
  }
  #v4 .leaf .recto::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(90deg, rgba(0,0,0,.22) 0%, transparent 14%);
    pointer-events:none;
  }
  /* Verso = the chapter title page (becomes left page when leaf reaches -180deg) */
  #v4 .leaf .verso{
    transform:rotateY(180deg);
    background:linear-gradient(180deg,#F8EFDC 0%,#EFE2CB 100%);
    box-shadow:inset -28px 0 36px -16px rgba(0,0,0,.18);
    display:flex;align-items:center;justify-content:flex-start;
    padding:10% 12%;
    border-radius:2px 0 0 2px;
  }
  #v4 .leaf .verso::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(90deg, transparent 86%, rgba(0,0,0,.22) 100%);
    pointer-events:none;
  }
  #v4 .leaf .verso .vcap{
    font-family:'Fraunces',serif;color:var(--ink);max-width:100%;
  }
  #v4 .leaf .verso .vcap .chnum{
    font-style:italic;font-weight:300;font-size:84px;line-height:1;color:var(--emerald);
  }
  #v4 .leaf .verso .vcap .chof{
    font-family:'Inter';font-size:10px;letter-spacing:.22em;text-transform:uppercase;
    color:var(--ink-soft);margin-bottom:14px;
  }
  #v4 .leaf .verso .vcap .chrule{
    width:48px;height:1px;background:var(--emerald);margin:18px 0 14px;
  }
  #v4 .leaf .verso .vcap .chtitle{
    font-weight:400;font-size:24px;line-height:1.2;letter-spacing:-.01em;
  }

  /* Caption beneath book */
  #v4 .caption{
    position:absolute;left:0;right:0;bottom:-44px;
    display:flex;justify-content:space-between;align-items:flex-end;
    color:var(--cream);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
    z-index:7;padding:0 4%;
  }
  #v4 .caption em{font-family:'Fraunces',serif;font-style:italic;text-transform:none;letter-spacing:0;font-size:18px;color:var(--emerald-bright)}

  #v4 .footer-row{
    display:flex;justify-content:space-between;align-items:center;color:var(--ink-soft);
    font-size:11px;letter-spacing:.2em;text-transform:uppercase;
  }

  /* shared bottom progress */
  .scroll-hint{
    position:fixed;right:24px;bottom:24px;z-index:20;
    color:var(--ink-soft);font-size:11px;letter-spacing:.2em;text-transform:uppercase;
    display:flex;align-items:center;gap:10px;
    background:rgba(251,246,234,.85);padding:8px 12px;border-radius:999px;border:1px solid var(--rule);
    backdrop-filter:blur(8px);
  }
  .scroll-hint .dot{width:6px;height:6px;border-radius:50%;background:var(--emerald);animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

  @media (max-width:820px){
    #v4 .layout{grid-template-columns:1fr}
    #v4 .right{display:none}
    .tabs{display:none}
  }
</style>
</head>
<body>

<div class="selector">
  <div class="selector-inner">
    <div class="brand">
      <img src="logo.svg" alt="Self-Healing Communities Fund" />
      <small>Hero Concepts · v1</small>
    </div>
    <div class="tabs" role="tablist">
      <button class="tab active" data-v="v1"><span class="num">01</span>The Unfolding Book</button>
      <button class="tab" data-v="v3"><span class="num">02</span>Wayfinding</button>
      <button class="tab" data-v="v4"><span class="num">03</span>Life Course</button>
    </div>
  </div>
</div>

<!-- =================================================================
     VERSION 1 — The Unfolding Book
     ================================================================= -->
<section class="stage active" id="v1">
  <div class="desc">
    <b>01 · The Unfolding Book</b>
    <span>Bold ideas unfold like the pages of a leporello book. Scroll opens each fold — warm cream gives way to deep red, then to ink, as the story moves from fragmentation to flow.</span>
  </div>
  <div class="scroll-area" data-scroll="v1">
    <div class="sticky">
      <div class="grain"></div>

      <div class="copy-panel">
        <div>
          <div class="eyebrow" style="margin-bottom:22px">Self-Healing Communities Fund</div>
          <h1 class="h1">An ancient story,<br><em>told in a new way.</em></h1>
          <p class="lede">Communities have always carried their own intelligence. The Fund invests in places where that intelligence is built back into the everyday, so people can orient, gather, and heal without waiting for someone to walk them through it.</p>
          <div style="margin-top:32px"><a class="btn" href="#">Open the story <span class="arrow">→</span></a></div>
        </div>
        <div class="foot">
          <span>Scroll to unfold</span>
          <span class="line"></span>
          <span id="v1-count">01 / 05</span>
        </div>
      </div>

      <div class="accordion" id="v1-accordion">
        <div class="page p1">
          <div class="pnum">01 — Fragmented</div>
          <div class="img" style="background-image:url('https://images.unsplash.com/photo-1542810634-71277d95dcbb?w=1100&q=85')"></div>
          <h3>A system that depends on rescue.</h3>
          <p>Bottlenecks, burnout, services that arrive after the harm.</p>
        </div>
        <div class="page p2">
          <div class="pnum">02 — Pressure</div>
          <div class="img" style="background-image:url('https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?w=1100&q=85')"></div>
          <h3>The cost of constant intervention.</h3>
          <p>Reactive, expensive, hard to scale across generations.</p>
        </div>
        <div class="page p3">
          <div class="pnum">03 — Turning</div>
          <div class="img" style="background-image:url('https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1100&q=85')"></div>
          <h3>What if the place itself could guide us?</h3>
          <p>Wayfinding embedded in libraries, gardens, gathering spaces.</p>
        </div>
        <div class="page p4">
          <div class="pnum">04 — Flow</div>
          <div class="img" style="background-image:url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=1100&q=85')"></div>
          <h3>Distributed coordination.</h3>
          <p>People orient, neighbors connect, services arrive lighter.</p>
        </div>
        <div class="page p5">
          <div class="pnum">05 — Self-Healing</div>
          <div class="img" style="background-image:url('https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=1100&q=85')"></div>
          <h3>A community that holds itself.</h3>
          <p>Less friction. Fewer crises. More serendipity, by design.</p>
        </div>
      </div>

      <div class="progress">
        <span>Fragmented</span>
        <div class="bar"><i id="v1-bar"></i></div>
        <span>Self-Healing</span>
      </div>
    </div>
  </div>
</section>

<!-- =================================================================
     VERSION 2 — Wayfinding (particles → flow)
     ================================================================= -->
<section class="stage" id="v3">
  <div class="desc">
    <b>03 · Wayfinding</b>
    <span>Hundreds of scattered points slowly find a current. As the river forms, real photographs of the communities the Fund supports surface along its banks — the page itself demonstrates what we build.</span>
  </div>
  <div class="scroll-area" data-scroll="v3">
    <div class="sticky">
      <canvas id="v3-canvas"></canvas>

      <div class="corners">
        <div>Self-Healing Communities Fund<br><span style="opacity:.6">est. 2026 · Anda &amp; Porter</span></div>
        <div class="r">A project of ACE Interface<br><span style="opacity:.6">Scroll to find your way</span></div>
      </div>

      <div class="photos">
        <div class="ph p1" style="background-image:url('https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1200&q=85')"></div>
        <div class="ph p2" style="background-image:url('https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?w=1200&q=85')"></div>
        <div class="ph p3" style="background-image:url('https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=1200&q=85')"></div>
        <div class="ph p4" style="background-image:url('https://images.unsplash.com/photo-1542810634-71277d95dcbb?w=1200&q=85')"></div>
      </div>

      <div class="copy">
        <div class="eyebrow">Self-Healing Communities Fund</div>
        <h1 class="h1">Intelligence,<br><em>built into the place.</em></h1>
        <p class="lede" style="margin-left:auto;margin-right:auto">When the library, the garden, the gathering ground all know how to point you somewhere good, fewer people fall through. The Fund invests in that quiet, distributed wayfinding.</p>
        <a class="btn" href="#">Read the approach <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- =================================================================
     VERSION 4 — Life Course (chapters of a book)
     ================================================================= -->
<section class="stage" id="v4">
  <div class="desc">
    <b>04 · Life Course</b>
    <span>The site as a book about a life. Chapters are developmental stages, pages turn as you scroll, and each leaf carries a real community image. Multi-generational by structure, not by stock photo.</span>
  </div>
  <div class="scroll-area" data-scroll="v4">
    <div class="sticky">
      <div class="layout">
        <div class="left">
          <div>
            <div class="eyebrow">Self-Healing Communities Fund</div>
            <h1 class="h1" style="margin-top:24px">A life,<br>held by the <em>place</em><br>it grows in.</h1>
          </div>

          <div class="stages" id="v4-stages">
            <div class="stage-item" data-i="0">
              <h2>Earliest years.</h2>
              <p>Childcare, libraries, and elders close enough to matter.</p>
            </div>
            <div class="stage-item" data-i="1">
              <h2>School and street.</h2>
              <p>Recreation, gardens, gathering spaces a child can navigate alone.</p>
            </div>
            <div class="stage-item" data-i="2">
              <h2>Coming of age.</h2>
              <p>Work, markets, mentors. A community that has somewhere to be.</p>
            </div>
            <div class="stage-item" data-i="3">
              <h2>Raising the next.</h2>
              <p>Health resources within reach. Help that doesn't require a crisis.</p>
            </div>
            <div class="stage-item" data-i="4">
              <h2>Held by elders.</h2>
              <p>The story closes the loop — and a new book begins.</p>
            </div>
          </div>

          <div class="footer-row">
            <div class="chapter-label">
              <span class="num" id="v4-num">1</span>
              <span class="of">Chapter <span id="v4-of">1</span> of 5</span>
            </div>
            <a class="btn" href="#">Open the book <span class="arrow">→</span></a>
          </div>
        </div>

        <div class="right">
          <div class="book" id="v4-book">
            <span class="edge left"></span>
            <span class="edge right"></span>

            <!-- static cream base spread, sits beneath all leaves -->
            <div class="book-base">
              <div class="page page-left"><div class="end-mark">— a quiet beginning —</div></div>
              <div class="page page-right"><div class="end-mark">— and so the book closes —</div></div>
            </div>

            <!-- leaves stack on right; each pivots on the spine -->
            <div class="leaves" id="v4-leaves">
              <div class="leaf" data-i="0">
                <div class="face recto" style="background-image:url('https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?w=1400&q=85')"></div>
                <div class="face verso"><div class="vcap">
                  <div class="chof">Chapter One</div>
                  <div class="chnum">01</div>
                  <div class="chrule"></div>
                  <div class="chtitle">Earliest years.</div>
                </div></div>
              </div>
              <div class="leaf" data-i="1">
                <div class="face recto" style="background-image:url('https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1400&q=85')"></div>
                <div class="face verso"><div class="vcap">
                  <div class="chof">Chapter Two</div>
                  <div class="chnum">02</div>
                  <div class="chrule"></div>
                  <div class="chtitle">School and street.</div>
                </div></div>
              </div>
              <div class="leaf" data-i="2">
                <div class="face recto" style="background-image:url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=1400&q=85')"></div>
                <div class="face verso"><div class="vcap">
                  <div class="chof">Chapter Three</div>
                  <div class="chnum">03</div>
                  <div class="chrule"></div>
                  <div class="chtitle">Coming of age.</div>
                </div></div>
              </div>
              <div class="leaf" data-i="3">
                <div class="face recto" style="background-image:url('https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=1400&q=85')"></div>
                <div class="face verso"><div class="vcap">
                  <div class="chof">Chapter Four</div>
                  <div class="chnum">04</div>
                  <div class="chrule"></div>
                  <div class="chtitle">Raising the next.</div>
                </div></div>
              </div>
              <div class="leaf" data-i="4">
                <div class="face recto" style="background-image:url('https://images.unsplash.com/photo-1542810634-71277d95dcbb?w=1400&q=85')"></div>
                <div class="face verso"><div class="vcap">
                  <div class="chof">Chapter Five</div>
                  <div class="chnum">05</div>
                  <div class="chrule"></div>
                  <div class="chtitle">Held by elders.</div>
                </div></div>
              </div>
            </div>

            <div class="spine"></div>
          </div>

          <div class="caption">
            <div><em id="v4-cap">Earliest years</em><br><span style="opacity:.6">Now reading · Chapter <span id="v4-cap-n">01</span></span></div>
            <div style="text-align:right;opacity:.7">Self-Healing<br>Communities Fund</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="scroll-hint"><span class="dot"></span> Scroll to animate</div>

<script>
  /* ---------- tab switching ---------- */
  const tabs = document.querySelectorAll('.tab');
  const stages = document.querySelectorAll('.stage');
  const brandSmall = document.querySelector('.brand small');
  tabs.forEach(t=>{
    t.addEventListener('click',()=>{
      tabs.forEach(x=>x.classList.remove('active'));
      stages.forEach(s=>s.classList.remove('active'));
      t.classList.add('active');
      const v = t.dataset.v;
      document.getElementById(v).classList.add('active');
      brandSmall.textContent = 'Hero Concepts · ' + v;
      window.scrollTo({top:0,behavior:'instant'});
    });
  });

  /* helper: scroll progress for a section's scroll-area */
  function progressOf(el){
    const r = el.getBoundingClientRect();
    const h = window.innerHeight;
    const total = el.offsetHeight - h;
    const passed = Math.min(Math.max(-r.top,0), total);
    return total>0 ? passed/total : 0;
  }

  /* ============================================================
     V1 — Accordion unfold
     ============================================================ */
  const v1Section = document.querySelector('#v1 .scroll-area');
  const v1Pages = document.querySelectorAll('#v1 .page');
  const v1Bar = document.getElementById('v1-bar');
  const v1Count = document.getElementById('v1-count');
  function tickV1(){
    if(!document.getElementById('v1').classList.contains('active')) return;
    const p = progressOf(v1Section);
    v1Bar.style.width = (p*100).toFixed(1)+'%';
    const idx = Math.min(Math.floor(p*5)+1, 5);
    v1Count.textContent = String(idx).padStart(2,'0') + ' / 05';
    // open fold gradually: each page rotates from -160deg → 0
    v1Pages.forEach((page,i)=>{
      const start = i*0.13;
      const end = start + 0.32;
      const local = Math.min(Math.max((p-start)/(end-start),0),1);
      const isEven = i%2===1;
      const startAngle = isEven ? 160 : -160;
      const angle = startAngle * (1-local);
      const tx = (i-2) * 4; // tiny drift
      page.style.transform = `rotateY(${angle}deg) translateX(${tx}px)`;
      page.style.opacity = 0.4 + local*0.6;
    });
  }

  /* ============================================================
     V3 — particles canvas (Wayfinding)
     ============================================================ */
  const v3Section = document.querySelector('#v3 .scroll-area');
  const cvs = document.getElementById('v3-canvas');
  const ctx = cvs.getContext('2d');
  let particles = [];
  let v3W=0, v3H=0;
  function sizeV3(){
    const r = cvs.getBoundingClientRect();
    v3W = cvs.width = r.width * devicePixelRatio;
    v3H = cvs.height = r.height * devicePixelRatio;
    initParticles();
  }
  function initParticles(){
    particles = [];
    const count = Math.floor(v3W*v3H / 9000);
    for(let i=0;i<count;i++){
      particles.push({
        // chaos start
        cx: Math.random()*v3W,
        cy: Math.random()*v3H,
        // flow target: along a sine river across the middle
        tx: 0, ty: 0, phase: Math.random()*Math.PI*2,
        r: Math.random()*1.6 + 0.6,
      });
    }
    particles.forEach(p=>{
      const t = Math.random();
      p.tx = t * v3W;
      p.ty = v3H*0.55 + Math.sin(t*Math.PI*2.4)*v3H*0.18 + (Math.random()*40-20)*devicePixelRatio;
    });
  }
  window.addEventListener('resize', sizeV3);
  sizeV3();

  const v3Photos = document.querySelectorAll('#v3 .ph');
  function tickV3(){
    if(!document.getElementById('v3').classList.contains('active')) return;
    const p = progressOf(v3Section);
    ctx.clearRect(0,0,v3W,v3H);
    // background hue shift via overlay? we just animate particles
    particles.forEach((pt,i)=>{
      const x = pt.cx + (pt.tx - pt.cx) * easeOut(p);
      // add gentle wave once near target
      const wave = Math.sin(pt.phase + p*6) * 4 * devicePixelRatio * p;
      const y = pt.cy + (pt.ty - pt.cy) * easeOut(p) + wave;
      const alpha = 0.25 + p*0.55;
      // chaos warm terracotta (201,68,47) → flow deep emerald (0,145,105) → bright emerald hint
      const r = Math.round(201 + (0   - 201)*p);
      const g = Math.round(68  + (145 - 68 )*p);
      const b = Math.round(47  + (105 - 47 )*p);
      ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
      ctx.beginPath();
      ctx.arc(x,y,pt.r*devicePixelRatio*(1+p*0.4),0,Math.PI*2);
      ctx.fill();
    });
    // reveal photos as p crosses thresholds
    [0.25,0.45,0.65,0.85].forEach((th,idx)=>{
      v3Photos[idx].classList.toggle('show', p>th);
    });
  }
  function easeOut(t){return 1-Math.pow(1-t,3)}

  /* ============================================================
     V4 — book with proper recto/verso flipping leaves
     ============================================================ */
  const v4Section = document.querySelector('#v4 .scroll-area');
  const v4Leaves = document.querySelectorAll('#v4 .leaf');
  const v4Items = document.querySelectorAll('#v4 .stage-item');
  const v4Num = document.getElementById('v4-num');
  const v4Of = document.getElementById('v4-of');
  const v4Cap = document.getElementById('v4-cap');
  const v4CapN = document.getElementById('v4-cap-n');
  const captions = ['Earliest years','School and street','Coming of age','Raising the next','Held by elders'];

  // Smooth scroll progress for buttery flips
  let v4Smooth = 0;
  function v4Lerp(a,b,t){return a + (b-a)*t}

  function tickV4(){
    if(!document.getElementById('v4').classList.contains('active')) return;
    const target = progressOf(v4Section);
    v4Smooth = v4Lerp(v4Smooth, target, 0.15);
    const p = v4Smooth;
    const total = v4Leaves.length;        // 5 leaves
    const turns = total;                  // map p∈[0,1] across 5 flip slots
    let flippedCount = 0;

    v4Leaves.forEach((leaf,i)=>{
      // per-leaf progress 0..1 — staggered across the scroll
      const local = Math.max(0, Math.min(1, p*turns - i));
      const angle = -local * 180;
      leaf.style.transform = `rotateY(${angle}deg)`;
      // z-index: unflipped leaves stack so leaf 0 is on top of right side;
      // once a leaf passes the spine (local >= 0.5), its z jumps so it stacks on TOP of previously-flipped leaves on the left
      if(local < 0.5){
        leaf.style.zIndex = 50 - i;           // 50..46  — leaf 0 on top of right stack
      } else {
        leaf.style.zIndex = 100 + i;          // 100..104 — leaf 4 on top of left stack
        flippedCount++;
      }
    });

    // active chapter = which photo is currently on the right page
    const idx = Math.min(flippedCount, total-1);
    v4Items.forEach((it,i)=>it.classList.toggle('active', i===idx));
    v4Num.textContent = idx+1;
    v4Of.textContent = idx+1;
    v4Cap.textContent = captions[idx];
    if(v4CapN) v4CapN.textContent = String(idx+1).padStart(2,'0');
  }

  /* central RAF loop */
  function loop(){
    tickV1();
    tickV3();
    tickV4();
    requestAnimationFrame(loop);
  }
  loop();
</script>
</body>
</html>
